# =============================================================
#  SatSched – Root .gitignore
#  Covers both the Next.js frontend and the Spring Boot backend.
#  Everything listed here can be rebuilt / reinstalled locally:
#    • Node  → npm install / npm i
#    • Maven → mvn package  (or ./mvnw package)
# =============================================================


# ---------------------------------------------------------------
# Node / npm / Next.js  (frontend/)
# ---------------------------------------------------------------

# Installed packages – reinstall with: npm install
**/node_modules/

# Next.js build output – rebuild with: npm run build
**/.next/
**/out/

# Production build artefacts
**/build/
**/dist/

# npm / yarn / pnpm caches & lock-file noise
**/.npm/
**/.yarn/
**/.pnp
**/.pnp.js
**/.yarn/install-state.gz

# TypeScript incremental compilation cache
**/*.tsbuildinfo

# Test coverage
**/coverage/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js auto-generated type declarations
**/next-env.d.ts

# Vercel deployment artefacts
**/.vercel/


# ---------------------------------------------------------------
# Java / Maven / Spring Boot  (timetablescheduler/)
# ---------------------------------------------------------------

# Maven build output – rebuild with: ./mvnw package
**/target/

# Maven wrapper binary (can be re-downloaded by mvnw script)
**/.mvn/wrapper/maven-wrapper.jar

# Compiled class files
**/*.class

# JAR / WAR / EAR / RAR artefacts
**/*.jar
**/*.war
**/*.ear
**/*.rar

# Maven Surefire / Failsafe test reports
**/surefire-reports/
**/failsafe-reports/

# Spring Boot dev-tools restart trigger
**/.spring-boot-devtools.properties


# ---------------------------------------------------------------
# IDE & editor files
# ---------------------------------------------------------------

# IntelliJ IDEA
**/.idea/
**/*.iws
**/*.iml
**/*.ipr

# Eclipse / STS (Spring Tool Suite)
**/.apt_generated/
**/.classpath
**/.factorypath
**/.project
**/.settings/
**/.springBeans
**/.sts4-cache/

# NetBeans
**/nbproject/private/
**/nbbuild/
**/nbdist/
**/.nb-gradle/

# VS Code
**/.vscode/

# Vim / Emacs swap files
**/*.swp
**/*.swo
**/*~


# ---------------------------------------------------------------
# OS artefacts
# ---------------------------------------------------------------

# macOS
**/.DS_Store
**/.AppleDouble
**/.LSOverride

# Windows
**/Thumbs.db
**/ehthumbs.db
**/Desktop.ini
**/$RECYCLE.BIN/

# Linux
**/.directory


# ---------------------------------------------------------------
# Environment / secrets  (never commit these)
# ---------------------------------------------------------------

# Local environment variable files
**/.env
**/.env.local
**/.env.*.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Certificate / key files
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore

